{
  "name": "layarpro",
  "version": "2.0.0",
  "description": "LayarPro - Perekam layar dan rapat, offline-first dan PWA capable.",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./css/input.css -o ./dist/styles.css --minify",
    "watch:css": "tailwindcss -i ./css/input.css -o ./dist/styles.css --watch",
    "build": "npm run build:css",
    "lint": "node --check js/*.js && node --check sw.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "tailwindcss": "^3.4.13",
    "vitest": "^5.0.0"
  }
}
